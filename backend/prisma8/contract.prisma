// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Users {
  id                 String               @id(map: "users_pkey")
  email              String
  createdAt          Timestamp(3)         @default(now())
  passwordHash       String
  avatarUrl          String?
  userName           String?
  userPhone          String?
  habits             Habits[]
  passwordResetCodes PasswordResetCodes[]
  routines           Routines[]

  @@index([email], map: "users_email_key", unique: true)
  @@map("users")
}

model Habits {
  id            String          @id(map: "habits_pkey")
  name          String
  color         String?
  archivedAt    Timestamp(3)?
  createdAt     Timestamp(3)    @default(now())
  userId        String
  habitEntries  HabitEntries[]
  routineHabits RoutineHabits[]
  user          Users           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "habits_userId_fkey", index: false)

  @@map("habits")
}

model HabitEntries {
  id        String       @id(map: "habit_entries_pkey")
  date      Date
  createdAt Timestamp(3) @default(now())
  habitId   String
  habit     Habits       @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "habit_entries_habitId_fkey", index: false)

  @@index([habitId, date], map: "habit_entries_habitId_date_key", unique: true)
  @@map("habit_entries")
}

model PasswordResetCodes {
  id         String        @id(map: "password_reset_codes_pkey")
  userId     String
  codeHash   String
  expiresAt  Timestamp(3)
  attempts   Int           @default(0)
  verifiedAt Timestamp(3)?
  consumedAt Timestamp(3)?
  createdAt  Timestamp(3)  @default(now())
  user       Users         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_reset_codes_userId_fkey", index: false)

  @@index([userId, createdAt], map: "password_reset_codes_userId_createdAt_idx")
  @@map("password_reset_codes")
}

model Routines {
  id            String          @id(map: "routines_pkey")
  userId        String
  name          String
  description   String?
  color         String?
  cadence       String?
  createdAt     Timestamp(3)    @default(now())
  updatedAt     Timestamp(3)
  routineHabits RoutineHabits[]
  user          Users           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "routines_userId_fkey")

  @@index([userId], map: "routines_userId_idx")
  @@map("routines")
}

model RoutineHabits {
  routineId       String
  habitId         String
  order           Int
  durationMinutes Int      @default(5)
  habit           Habits   @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "routine_habits_habitId_fkey")
  routine         Routines @relation(fields: [routineId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "routine_habits_routineId_fkey", index: false)

  @@id([routineId, habitId], map: "routine_habits_pkey")
  @@index([habitId], map: "routine_habits_habitId_idx")
  @@map("routine_habits")
}

// use prisma-8
// The single source of truth for the database. Queries are typed from the
// emitted contract (`pnpm prisma:emit`); migrations are planned from it.
// `@default(uuid())` ids are generated by the client, not the database.

model User {
  id                 String              @id(map: "users_pkey") @default(uuid())
  email              String
  createdAt          Timestamp(3)        @default(now())
  passwordHash       String
  avatarUrl          String?
  userName           String?
  userPhone          String?
  habits             Habit[]
  passwordResetCodes PasswordResetCode[]
  routines           Routine[]

  @@index([email], map: "users_email_key", unique: true)
  @@map("users")
}

model Habit {
  id           String         @id(map: "habits_pkey") @default(uuid())
  name         String
  color        String?
  archivedAt   Timestamp(3)?
  createdAt    Timestamp(3)   @default(now())
  userId       String
  entries      HabitEntry[]
  routineSteps RoutineHabit[]
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "habits_userId_fkey", index: false)

  @@map("habits")
}

model HabitEntry {
  id        String       @id(map: "habit_entries_pkey") @default(uuid())
  date      Date
  createdAt Timestamp(3) @default(now())
  habitId   String
  habit     Habit        @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "habit_entries_habitId_fkey", index: false)

  @@index([habitId, date], map: "habit_entries_habitId_date_key", unique: true)
  @@map("habit_entries")
}

model PasswordResetCode {
  id         String        @id(map: "password_reset_codes_pkey") @default(uuid())
  userId     String
  codeHash   String
  expiresAt  Timestamp(3)
  attempts   Int           @default(0)
  verifiedAt Timestamp(3)?
  consumedAt Timestamp(3)?
  createdAt  Timestamp(3)  @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_reset_codes_userId_fkey", index: false)

  @@index([userId, createdAt], map: "password_reset_codes_userId_createdAt_idx")
  @@map("password_reset_codes")
}

// `updatedAt` has no default: RoutineService stamps it on every write.
model Routine {
  id          String         @id(map: "routines_pkey") @default(uuid())
  userId      String
  name        String
  description String?
  color       String?
  cadence     String?
  createdAt   Timestamp(3)   @default(now())
  updatedAt   Timestamp(3)
  steps       RoutineHabit[]
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "routines_userId_fkey")

  @@index([userId], map: "routines_userId_idx")
  @@map("routines")
}

model RoutineHabit {
  routineId       String
  habitId         String
  order           Int
  durationMinutes Int     @default(5)
  habit           Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "routine_habits_habitId_fkey")
  routine         Routine @relation(fields: [routineId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "routine_habits_routineId_fkey", index: false)

  @@id([routineId, habitId], map: "routine_habits_pkey")
  @@index([habitId], map: "routine_habits_habitId_idx")
  @@map("routine_habits")
}
